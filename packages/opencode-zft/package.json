{
  "name": "opencode-zft",
  "version": "0.3.0",
  "description": "opencode gates for zft \u2014 the contract-first traceability framework. A dispatch gate that requires a contract binding before implementation work, and an L0 lint gate that fires on every .zft/ edit.",
  "type": "module",
  "main": "index.ts",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jlamweil/zft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlamweil/zft.git"
  },
  "bugs": {
    "url": "https://github.com/jlamweil/zft/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "zft",
    "contract-first",
    "traceability",
    "gate",
    "multiagent"
  ],
  "files": [
    "index.ts",
    "core",
    "zft-gate.ts",
    "zft-lint-gate.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/sync-zft-gates.mjs && node ../../scripts/sync-zft-gates.mjs --assert",
    "pretest": "node ../../scripts/sync-zft-gates.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest"
  }
}
